# Kiosk PC settings for the campus platform. Copy to kiosk/.env (git-ignored)
# on the kiosk PC and fill in. pc_client.py reads it at start-up; variables
# already set in the shell take precedence. Never commit the real file, and
# never put these values into the ESP32 or UNO Q firmware.

# The campus website (apps/campus_web), without a trailing slash.
CAMPUS_API_URL=https://campus.example.edu

# A device key from Dashboard > Kiosk > Device keys. Tick "Submit RFID
# check-ins" (and "Kiosk" for kiosk/campus_api_client.py). Shown once when
# created; revoke it in the dashboard if this PC is lost.
CAMPUS_KIOSK_KEY=

# RFID attendance (card taps forwarded to the website) is turned off for now.
# Set to "on" only together with RFID_ENABLED 1 in firmware/include/config.h.
RFID_ATTENDANCE=off
