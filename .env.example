# Copy to .env and edit.

# ---------------------------------------------------------------------------
# Gemma backend: "gemini" (Google AI Studio, nothing to install) or
#                "ollama"  (local, offline, needs ~3.5 GB of models pulled)
# ---------------------------------------------------------------------------
LLM_BACKEND=gemini

# --- used when LLM_BACKEND=gemini --------------------------------------------
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Run `python scripts/list_models.py` to see the exact Gemma ids your key can call.
GEMINI_MODEL=gemma-4-26b-a4b-it
# Tried when the main model fails twice (Google's free tier returns intermittent HTTP 500s).
GEMINI_FALLBACK_MODEL=gemma-4-31b-it
# minimal = reasoning off: ~4 s answers instead of 30-60 s. Leave empty to let Gemma reason.
GEMINI_THINKING=minimal

# --- used when LLM_BACKEND=ollama --------------------------------------------
OLLAMA_URL=http://localhost:11434
GEMMA_MODEL=gemma3:4b

# ---------------------------------------------------------------------------
# RAG embeddings. EMBED_BACKEND defaults to whatever LLM_BACKEND is, so the
# gemini setup above needs no local model server. Leave EMBED_MODEL empty to
# fall back to TF-IDF keyword matching only (weaker, but needs nothing).
# ---------------------------------------------------------------------------
#   gemini  -> gemini-embedding-001  (or whatever list_models.py shows)
#   ollama  -> embeddinggemma
EMBED_MODEL=gemini-embedding-001
# EMBED_BACKEND=gemini
# Measured for gemini-embedding-001 with scripts/tune_gate.py.
# Re-run that script after changing EMBED_MODEL: score scales differ a lot.
EMB_MIN_SCORE=0.67
TFIDF_MIN_SCORE=0.11

# --- Speech to text -----------------------------------------------------------
# sarvam  = api.sarvam.ai, better on Indian English and Indian languages
# whisper = faster-whisper, runs offline on the CPU
STT_PROVIDER=sarvam
SARVAM_API_KEY=
SARVAM_MODEL=saaras:v4
SARVAM_LANGUAGE=en-IN      # kn-IN for Kannada, hi-IN for Hindi, unknown to auto-detect

# --- Speech (whisper STT + edge-tts voice) ------------------------------------
WHISPER_MODEL=base.en
STT_LANGUAGE=en
TTS_VOICE=en-IN-NeerjaNeural
TTS_ENABLED=1
# Say which knowledge-base file an answer came from, at the end of the spoken answer.
SPEAK_SOURCES=1
ESP_PLAY_RATE=8000
# Sample rate of speech sent to the I2S amplifier (MAX98357A). Must equal PLAY_RATE in firmware/include/config.h.
ESP_I2S_RATE=16000

HOST=0.0.0.0
PORT=8000
