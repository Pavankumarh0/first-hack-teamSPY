# Campus Mithra student app settings. Copy to .env (never committed) and run:
#   flutter run --dart-define-from-file=.env
# These are compiled into the app. They identify your Firebase project and are
# not secrets: the security rules control access. Never put a service-account
# key or any server credential here.
# Firebase console > Project settings > Your apps > (Android/iOS app) values.
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
IOS_BUNDLE_ID=edu.campusmithra.student

# The campus website (apps/campus_web). Registration goes through its backend,
# and QR codes from that host open inside the app.
CAMPUS_SITE_URL=https://campus.example.edu

# Local development with the Firebase emulators instead of a real project:
# set true; the Firebase values above may then stay empty.
USE_FIREBASE_EMULATORS=false
# 10.0.2.2 = your computer, as seen from the Android emulator. Use your
# computer's LAN IP for a physical phone, or localhost for flutter run -d chrome.
FIREBASE_EMULATOR_HOST=10.0.2.2
