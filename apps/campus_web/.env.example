# Campus Mithra website + admin dashboard + backend API.
# Copy to .env.local (never committed) and fill in. docs/FIREBASE_SETUP.md
# explains where each value comes from.

# ---------------------------------------------------------------------------
# Public: compiled into the browser bundle. These identify your Firebase web
# app; they are not secrets (access is controlled by firestore.rules /
# storage.rules). Firebase console > Project settings > Your apps > Web app.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Local development without a Firebase project: "true" connects to the
# emulators started by `cd firebase && npm run emulators:seeded`. The six
# values above may then stay empty.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
# NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1

# Public base URL of this site. Every QR code and kiosk link is built from it,
# so set it to your real domain (https://campus.example.edu) before printing.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_COLLEGE_NAME=Sri Venkateshwara Institute of Technology
# Optional store links shown on QR landing pages.
NEXT_PUBLIC_ANDROID_STORE_URL=
NEXT_PUBLIC_IOS_STORE_URL=

# Google Maps: satellite view, campus placement and live directions on the
# website. A *browser* key: in Google Cloud, enable "Maps JavaScript API" and
# "Geocoding API", and restrict the key to your site's domain(s). Leave empty
# to use the drawn campus plan only. docs/CAMPUS_MAP_SETUP.md
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional Map ID (Google Cloud > Map Management). DEMO_MAP_ID is used if empty.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# ---------------------------------------------------------------------------
# Server only: never prefix these with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
# Firebase Admin (registration, roles, kiosk keys) uses Application Default
# Credentials - on Firebase App Hosting / Cloud Run nothing else is needed.
# Locally: `gcloud auth application-default login`, or set
# GOOGLE_APPLICATION_CREDENTIALS to a service-account key file stored OUTSIDE
# this repository. Never paste the key's contents into any env file here.
FIREBASE_ADMIN_PROJECT_ID=your-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/home/you/secrets/campus-mithra-admin.json

# Student self-registration: open | invite | closed
#   invite = needs REGISTRATION_INVITE_CODE (shared with students on campus)
#   closed = only administrators create accounts (Dashboard > Users)
REGISTRATION_MODE=invite
REGISTRATION_INVITE_CODE=

# RFID attendance: secret for hashing card UIDs (32+ random characters,
# e.g. `openssl rand -hex 32`). Required before any card is registered or
# scanned. Card UIDs are stored only as HMAC-SHA256 with this secret, so
# changing it later makes every registered card unknown (re-register them).
# docs/RFID_BACKEND.md
RFID_UID_HMAC_SECRET=

# Mobile app links (docs/QR_DEEP_LINKS.md). Leave empty until the app is signed.
ANDROID_APP_PACKAGE=edu.campusmithra.student
ANDROID_SHA256_CERT_FINGERPRINTS=
APPLE_TEAM_ID=
IOS_BUNDLE_ID=edu.campusmithra.student
