# Copy to .env and edit
# --- Gemma backend: "ollama" (local, offline, default) or "gemini" (Google AI Studio API) ---
LLM_BACKEND=ollama
OLLAMA_URL=http://localhost:11434
GEMMA_MODEL=gemma3:4b
# Used only if LLM_BACKEND=gemini  (get a free key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemma-3-27b-it

# --- RAG embeddings (Gemma-family embedding model on Ollama). Leave empty to use TF-IDF only ---
EMBED_MODEL=embeddinggemma
EMB_MIN_SCORE=0.40
TFIDF_MIN_SCORE=0.08

# --- Speech ---
WHISPER_MODEL=base.en
STT_LANGUAGE=en
TTS_VOICE=en-IN-NeerjaNeural
TTS_ENABLED=1
ESP_PLAY_RATE=8000

HOST=0.0.0.0
PORT=8000
